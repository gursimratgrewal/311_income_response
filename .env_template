# We need to copy this to .env and fill in your values: cp .env_template .env
# Please don't commit .env, it has our keys.
# No spaces around the "=".

# Path to your service account key (.json). Only needed when running locally.
# Get it from IAM & Admin -> Service Accounts -> Keys -> Add key -> JSON.
# Keep it outside the repo (ex. ~/.ssh/).
GCP_SERVICE_ACCOUNT_KEY=/path/to/your-key.json

# Project ID from the GCP console (not the number).
GCP_PROJECT_ID=your-project-id

# Our bucket name, without gs://
GCP_BUCKET_NAME=data-acquisition-project-data

# Top folder in the bucket for raw files.
RAW_PREFIX=raw

# Seconds to wait for a download before giving up.
HTTP_TIMEOUT_SECONDS=120

# Census API key, free at https://api.census.gov/data/key_signup.html
# Click the link in the email to activate it first.
CENSUS_API_KEY=your-census-api-key

# API URL for the dashboard. Use the Cloud Run URL once deployed.
API_SERVICE_URL=http://127.0.0.1:8000
